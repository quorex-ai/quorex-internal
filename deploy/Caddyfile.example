# Reverse proxy HTTPS pour quorex-internal.
# Caddy obtient et renouvelle le certificat tout seul.
#
#   /etc/caddy/Caddyfile
#   systemctl reload caddy

internal.quorex.fr {
	encode zstd gzip

	# Le serveur Node ecoute en local uniquement, jamais expose directement.
	reverse_proxy 127.0.0.1:4317 {
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	log {
		output file /var/log/caddy/quorex-internal.log
	}
}
