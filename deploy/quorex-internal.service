[Unit]
Description=quorex-internal (dashboard interne de pilotage QUOREX)
Documentation=https://internal.quorex.fr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quorex
Group=quorex
WorkingDirectory=/opt/quorex-internal
EnvironmentFile=/opt/quorex-internal/.env
ExecStart=/usr/bin/node /opt/quorex-internal/server/dist/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quorex-internal

# Durcissement : le service n'ecrit que dans son dossier de donnees.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
UMask=0077
# DATABASE_PATH, DOCUMENTS_DIR et BACKUP_DIR doivent vivre sous ce chemin.
ReadWritePaths=/var/lib/quorex-internal

[Install]
WantedBy=multi-user.target
