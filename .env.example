# Configuration de quorex-internal.
# Les chemins ci-dessous sont ceux d'un VPS Debian 13 (trixie) et sont repris tels
# quels par Docker : /var/lib/quorex-internal est monté depuis l'hôte.

# Port HTTP du serveur (API + front compilé sur le même port).
# Il n'est jamais exposé publiquement : le reverse proxy est le seul point d'entrée.
PORT=4317

# Base SQLite. Le dossier parent est créé au démarrage s'il manque.
DATABASE_PATH=/var/lib/quorex-internal/data/quorex-internal.db

# Documents du coffre, hors dépôt et hors racine web. Créé en 700 au démarrage.
DOCUMENTS_DIR=/var/lib/quorex-internal/documents

# Archives de sauvegarde produites par « npm run backup ».
BACKUP_DIR=/var/lib/quorex-internal/backups

# Secret de signature des sessions, 32 caractères minimum, sinon le serveur refuse
# de démarrer. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# development | production | test
NODE_ENV=production

# Reverse proxy de confiance, pour que la limitation du login compte la vraie IP.
# « loopback » convient au nginx installé sur la machine.
TRUST_PROXY=loopback

# --- Développement local ---------------------------------------------------
# Remplacer les trois chemins par un dossier du dépôt et repasser en development :
#   DATABASE_PATH=./data/quorex-internal.db
#   DOCUMENTS_DIR=./data/documents
#   BACKUP_DIR=./data/backups
#   NODE_ENV=development
